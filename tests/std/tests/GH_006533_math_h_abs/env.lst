# This test inspects <math.h> and <stdlib.h> alone, so it avoids force_include.hpp's <stdlib.h>.
RUNALL_INCLUDE ..\prefix.lst
RUNALL_CROSSLIST
PM_CL="/DNO_TEST_ENVIRONMENT_PREPARER /EHsc /MD /std:c++14 /Zc:cmath"
PM_CL="/DNO_TEST_ENVIRONMENT_PREPARER /EHsc /MDd /std:c++17 /permissive- /Zc:cmath"
PM_CL="/DNO_TEST_ENVIRONMENT_PREPARER /EHsc /MT /std:c++20 /permissive- /Zc:cmath"
PM_CL="/DNO_TEST_ENVIRONMENT_PREPARER /EHsc /MTd /std:c++23 /permissive- /Zc:cmath"
PM_CL="/DNO_TEST_ENVIRONMENT_PREPARER /EHsc /MD /std:c++latest /permissive- /Zc:preprocessor /Zc:cmath"
PM_CL="/DNO_TEST_ENVIRONMENT_PREPARER /EHsc /MD /std:c++latest /permissive- /Zc:cmath-"
RUNALL_CROSSLIST
PM_CL=""
PM_CL="/DSTDLIB_H_BEFORE"
PM_CL="/DSTDLIB_H_AFTER"
PM_CL="/DCMATH_AFTER"
