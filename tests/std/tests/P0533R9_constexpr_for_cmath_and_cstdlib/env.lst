RUNALL_INCLUDE ..\usual_latest_matrix.lst

# Explicitly enable libc-based math:
PM_CL="/MD /experimental:mathlib"
PM_CL="/MDd /experimental:mathlib"
PM_CL="/MT /experimental:mathlib"
PM_CL="/MTd /experimental:mathlib"

# /O2 implies /Oi which affects <__msvc_math.hpp>:
PM_CL="/MD /experimental:mathlib /O2"
PM_CL="/MDd /experimental:mathlib /O2"
PM_CL="/MT /experimental:mathlib /O2"
PM_CL="/MTd /experimental:mathlib /O2"

# Explicitly disable libc-based math:
PM_CL="/MD /Zc:cmath-"
PM_CL="/MDd /Zc:cmath-"
PM_CL="/MT /Zc:cmath-"
PM_CL="/MTd /Zc:cmath-"
